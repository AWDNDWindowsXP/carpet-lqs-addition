{
  "schemaVersion": 1,
  "id": "carpet-lqs-addition",
  "version": "${version}",

  "name": "Carpet LQS Addition",
  "description": "A Carpet mod extension by LQS.",
  "authors": [
    "LQS"
  ],
  "contact": {},

  "license": "MIT",
  "icon": "assets/carpet_lqs_addition/icon.png",

  "environment": "*",
  "entrypoints": {
